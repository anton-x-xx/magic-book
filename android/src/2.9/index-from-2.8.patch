+function supplementExamples(words,bookId){
+ if(bookId!=='red'&&!/^study-fee0-[0-5]$/.test(bookId))return words;
+ for(const word of words){
+   const pairs=studyExamples.get(word.phrase.trim().toLowerCase());
+   if(!pairs)continue;
+   const examples=word.sentences||[];
+   const complete=examples.filter(p=>p.en?.trim()&&p.zh?.trim());
+   if(complete.length && pairs.length===1)continue;
+   const seen=new Set(complete.map(p=>p.en.toLowerCase().trim()));
+   const extra=pairs.filter(([en])=>!seen.has(en.toLowerCase().trim())).map(([en,zh])=>({en,zh}));
+   if(extra.length)word.sentences=[...complete,...extra,...examples.filter(p=>!complete.includes(p))];
+ }
+ return words;
