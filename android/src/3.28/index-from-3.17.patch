+function bookMatches(query){
+ const compact=normalizeSearch(query);
+ const candidates=entries.filter(e=>filterCat===ALL_TAGS||(e.category||'')===filterCat);
+ if(!compact)return candidates;
+ if(!/^[a-z0-9]+$/.test(compact))return candidates.filter(e=>matchesSearch(e,query));
+ const tokens=value=>String(value||'').normalize('NFKC').toLowerCase().normalize('NFD')
+   .replace(/[\u0300-\u036f]/g,'').replace(/['’]/g,'').match(/[a-z0-9]+/g)||[];
+ const exact=[],phrases=[];
+ for(const entry of candidates){
+   const words=tokens(entry.phrase);
+   if(normalizeSearch(entry.phrase)===compact){exact.push(entry);continue;}
+   // Compare complete, consecutive words so hyphens and spaces are interchangeable.
+   if(words.some((word,start)=>{
+     let joined=word;
+     for(let i=start+1;joined.length<compact.length&&i<words.length;i++)joined+=words[i];
+     return joined===compact;
+   }))phrases.push(entry);
+ }
+ return exact.concat(phrases);
+}
